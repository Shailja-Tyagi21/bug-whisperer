# Copy this file to .env and fill in your own values:
#     cp .env.example .env

# JIRA Cloud connection
JIRA_URL=https://your-company.atlassian.net
JIRA_EMAIL=your.name@your-company.com
JIRA_API_TOKEN=paste-your-token-here

# JQL query
JIRA_JQL=project = "YOUR-PROJECT" AND issuetype = Bug AND created >= -365d ORDER BY created DESC

# Output file
OUTPUT_CSV=jira_bugs.csv

# Safety cap
MAX_BUGS=50
